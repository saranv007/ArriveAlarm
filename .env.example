# ─── Frontend Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MapTiler API Key for map rendering and geocoding services
# Get a free key at: https://www.maptiler.com/
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Backend API URL (optional when using Vite dev server proxy in development)
# Leave empty in production — the frontend is served from the same Vercel domain
# and calls /api/... which is proxied by vercel.json rewrites.
# VITE_API_URL=http://localhost:3001

# ─── Backend / API Environment Variables ─────────────────────────────────────
# These MUST be set in Vercel Environment Variables (Settings → Environment Variables)
# They are also used by the server/ directory locally via server/.env

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# JWT signing secrets — use long random strings (32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-use-a-random-32-char-string
JWT_REFRESH_SECRET=change-me-use-another-random-32-char-string

# Google OAuth credentials
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# The exact OAuth redirect URI registered in Google Cloud Console
# Production: https://arrive-alarm.vercel.app/api/auth/google/callback
# Development: http://localhost:3001/api/auth/google/callback
GOOGLE_CALLBACK_URL=https://arrive-alarm.vercel.app/api/auth/google/callback

# Web Push (VAPID) keys for browser push notifications (optional)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@arrivealarm.app

# Application URLs
# Production frontend URL (used for CORS and OAuth redirects)
FRONTEND_URL=https://arrive-alarm.vercel.app

# Server port (local development only — not used on Vercel)
PORT=3001

# Node environment
NODE_ENV=production
