# Frontend Environment Variables (ArriveAlarm)

# MapTiler API Key for map rendering and geocoding services
# Get your free key at https://www.maptiler.com/
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# Backend API URL (optional if using Vite dev server proxy)
VITE_API_URL=http://localhost:3001
