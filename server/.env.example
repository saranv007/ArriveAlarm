# ─── ArriveAlarm Backend Environment Variables ───────────────────────────────
# Copy this file to server/.env for local server development.
# NEVER commit server/.env to git.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arrivealarm

# JWT signing secrets
JWT_SECRET=dev-jwt-secret-change-in-production-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod-32chars!!

# Google OAuth credentials (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Web Push (VAPID) keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@arrivealarm.app

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
