# ArriveAlarm Backend Environment Variables Configuration

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arrivealarm

# Authentication Secrets (JWT)
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-at-least-32-chars

# Google OAuth Credentials (Optional)
# Obtain from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Web Push Notifications - VAPID Keys
# Generate new keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@arrivealarm.app

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
